@model DashboardViewModel
@{
    ViewData["Title"]    = "Dashboard";
    ViewData["Subtitle"] = "Tổng quan hệ thống";
}

@section TopbarActions {
    <a class="btn btn-primary" asp-controller="Pois" asp-action="Create">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Thêm POI
    </a>
}

<div class="stats-grid">
  <div class="stat-card" style="--color: var(--orange);">
    <div class="stat-label">Tổng POI</div>
    <div class="stat-value">@Model.ActivePois<span class="stat-value-sub">/@Model.TotalPois</span></div>
    <div class="stat-sub">POI đang hoạt động</div>
    <div class="stat-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2C8 2 5 5 5 9c0 5 7 13 7 13s7-8 7-13c0-4-3-7-7-7z"/></svg></div>
  </div>

  <div class="stat-card" style="--color: var(--blue);">
    <div class="stat-label">Người dùng</div>
    <div class="stat-value">@Model.TotalUsers</div>
    <div class="stat-sub">Tài khoản hoạt động</div>
    <div class="stat-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></div>
  </div>

    <div class="stat-card" style="--color: var(--green);">
        <div class="stat-label">Online (90 giây)</div>  
        <div class="stat-value" id="stat-online">@Model.OnlineDevices</div>
        <div id="device-list" style="margin-top:8px;"></div>
    <div class="stat-sub"><span class="status-dot status-active"></span>Thiết bị đang kết nối</div>
    <div class="stat-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><polyline points="2 17 12 22 22 17"/></svg></div>
  </div>

  <div class="stat-card" style="--color: var(--purple);">
    <div class="stat-label">Lượt nghe hôm nay</div>
    <div class="stat-value">@Model.PlaysToday</div>
    <div class="stat-sub">30 ngày qua: @Model.Plays30Days</div>
    <div class="stat-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg></div>
  </div>
</div>

<div class="two-col">
  <div class="panel">
    <div class="panel-header">
      <div class="panel-title">Lượt nghe 30 ngày qua</div>
    </div>
    <div class="panel-body">
      <div class="chart-container"><canvas id="chart-daily"></canvas></div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-header">
      <div class="panel-title">Phân bố theo loại</div>
    </div>
    <div class="panel-body">
      <div class="chart-container"><canvas id="chart-category"></canvas></div>
    </div>
  </div>
</div>

<div class="two-col">
  <div class="panel">
    <div class="panel-header">
      <div class="panel-title">Top 10 quán hot</div>
      <a class="btn btn-ghost" asp-controller="Pois" asp-action="Index">Xem POI →</a>
    </div>
    <div class="panel-body">
      @if (!Model.TopPois.Any())
      {
        <div class="empty-state"><h3>Chưa có dữ liệu</h3><p>Log sẽ xuất hiện khi có người dùng nghe TTS.</p></div>
      }
      else
      {
        <div class="top-list">
          @for (int i = 0; i < Model.TopPois.Count; i++)
          {
            var p = Model.TopPois[i];
            <div class="top-item">
              <div class="top-rank">@(i+1)</div>
              <div class="top-info">
                <div class="top-name">@p.Name</div>
                <div class="top-meta">@CategoryLabel(p.Category) · @p.UniqueDevices thiết bị</div>
              </div>
              <div class="top-count">@p.PlayCount</div>
            </div>
          }
        </div>
      }
    </div>
  </div>

  <div class="panel">
    <div class="panel-header">
      <div class="panel-title">Ngôn ngữ TTS (30 ngày)</div>
    </div>
    <div class="panel-body">
      <div class="chart-container"><canvas id="chart-lang"></canvas></div>
    </div>
  </div>
</div>

<div class="panel">
  <div class="panel-header">
    <div class="panel-title">POI cập nhật gần đây</div>
    <a class="btn btn-ghost" asp-controller="Pois" asp-action="Index">Xem tất cả →</a>
  </div>
  <div class="panel-body compact">
    <table>
      <thead>
        <tr>
          <th>Tên quán</th>
          <th>Loại</th>
          <th>Trạng thái</th>
          <th>Cập nhật</th>
          <th style="text-align:right;">Thao tác</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var p in Model.RecentPois)
        {
          <tr>
            <td class="poi-name">@p.Name</td>
            <td><span class="badge badge-@p.Category">@CategoryLabel(p.Category)</span></td>
            <td><span class="status-dot @(p.IsActive ? "status-active" : "status-inactive")"></span>@(p.IsActive ? "Hoạt động" : "Tạm dừng")</td>
            <td style="color: var(--text-2); font-size: 12px;">@(p.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
            <td style="text-align:right;">
              <a class="btn-icon" asp-controller="Pois" asp-action="Edit" asp-route-id="@p.Id" title="Chỉnh sửa">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              </a>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@@4.4.0/dist/chart.umd.min.js"></script>
<script>
(() => {
  const dailyData = @Html.Raw(Json.Serialize(Model.DailyPlays.Select(d => new { d = d.PlayDate.ToString("yyyy-MM-dd"), c = d.PlayCount })));
  const catData   = @Html.Raw(Json.Serialize(Model.CategoryCounts));
  const langData  = @Html.Raw(Json.Serialize(Model.LanguageCounts));

  const colors = { Oc:'#FFA55C', Nuong:'#F87171', Lau:'#A78BFA', CaPhe:'#60A5FA', Khac:'#94A3B8' };
  const catLabels = { Oc:'Ốc', Nuong:'Nướng', Lau:'Lẩu', CaPhe:'Cà phê', Khac:'Khác' };

  // Daily line chart
  new Chart(document.getElementById('chart-daily'), {
    type: 'line',
    data: {
      labels: dailyData.map(x => x.d.slice(5)),  // MM-DD
      datasets: [{
        label: 'Lượt nghe',
        data: dailyData.map(x => x.c),
        borderColor: '#FF8C42',
        backgroundColor: ctx => {
          const g = ctx.chart.ctx.createLinearGradient(0,0,0,280);
          g.addColorStop(0, 'rgba(255,140,66,0.3)');
          g.addColorStop(1, 'rgba(255,140,66,0.01)');
          return g;
        },
        fill: true, tension: 0.35, borderWidth: 2.5,
        pointRadius: 3, pointBackgroundColor: '#FF8C42',
        pointBorderColor: '#111827', pointBorderWidth: 2
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        x: { grid: { color: '#1F2940' }, ticks: { color: '#9AA0B4' } },
        y: { grid: { color: '#1F2940' }, ticks: { color: '#9AA0B4' }, beginAtZero: true }
      }
    }
  });

  // Category doughnut
  const catKeys = Object.keys(catData);
  new Chart(document.getElementById('chart-category'), {
    type: 'doughnut',
    data: {
      labels: catKeys.map(k => catLabels[k] || k),
      datasets: [{
        data: catKeys.map(k => catData[k]),
        backgroundColor: catKeys.map(k => colors[k] || '#94A3B8'),
        borderColor: '#111827', borderWidth: 3
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false, cutout: '65%',
      plugins: { legend: { position: 'right', labels: { color: '#B4BCD0', padding: 10, font: { size: 12 } } } }
    }
  });

  // Language bar
  const langKeys = Object.keys(langData);
  if (langKeys.length === 0) {
    document.getElementById('chart-lang').parentElement.innerHTML = '<div class="empty-state"><h3>Chưa có dữ liệu</h3></div>';
  } else {
    new Chart(document.getElementById('chart-lang'), {
      type: 'bar',
      data: {
        labels: langKeys,
        datasets: [{
          data: langKeys.map(k => langData[k]),
          backgroundColor: ['#FF8C42','#60A5FA','#F87171','#A78BFA','#FFB84D'],
          borderRadius: 6, barThickness: 22
        }]
      },
      options: {
        indexAxis: 'y',
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          x: { grid: { color: '#1F2940' }, ticks: { color: '#9AA0B4' }, beginAtZero: true },
          y: { grid: { display: false }, ticks: { color: '#B4BCD0' } }
        }
      }
    });
  }

  // Auto-refresh online count every 30s
        // === ONLINE REALTIME ===
        async function refreshOnline() {
        try {
        const r = await fetch('/Home/OnlineCount');
        const d = await r.json();
        document.getElementById('stat-online').textContent = d.count;
        } catch(e) {}
        }
        refreshOnline();
        setInterval(refreshOnline, 3000); // poll mỗi 3 giây
</script>
}

@functions {
    string CategoryLabel(string c) => c switch
    {
        "Oc"    => "Ốc",
        "Nuong" => "Nướng",
        "Lau"   => "Lẩu",
        "CaPhe" => "Cà phê",
        _       => "Khác"
    };
}
