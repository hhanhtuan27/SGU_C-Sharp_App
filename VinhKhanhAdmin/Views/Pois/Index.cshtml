@model PoiListViewModel
@{
    ViewData["Title"]    = Model.ShowDeleted ? "POI đã xóa" : "Quản lý POI";
    ViewData["Subtitle"] = Model.ShowDeleted ? "Có thể khôi phục lại" : "Danh sách điểm ẩm thực";
}

@section TopbarActions {
    <a class="btn btn-secondary" asp-controller="Pois" asp-action="Index" asp-route-deleted="@(!Model.ShowDeleted)">
        @(Model.ShowDeleted ? "← POI đang hoạt động" : "Xem POI đã xóa")
    </a>
    @if (!Model.ShowDeleted)
    {
      <a class="btn btn-primary" asp-controller="Pois" asp-action="Create">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Thêm POI
      </a>
    }
}

<form method="get" class="toolbar">
  <input type="hidden" name="deleted" value="@Model.ShowDeleted.ToString().ToLower()" />
  <div class="search-box">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <input type="text" name="q" placeholder="Tìm theo tên quán..." value="@Model.SearchQuery" />
  </div>
  <div class="chip-group">
    @foreach (var (key, label) in new[] { ("all","Tất cả"), ("Oc","🐚 Ốc"), ("Nuong","🔥 Nướng"), ("Lau","🍲 Lẩu"), ("CaPhe","☕ Cà phê"), ("Khac","🍽️ Khác") })
    {
      <a class="chip @(Model.CategoryFilter == key ? "active" : "")"
         href="?cat=@key&q=@Model.SearchQuery&deleted=@Model.ShowDeleted.ToString().ToLower()">@label</a>
    }
  </div>
  <button type="submit" class="btn btn-secondary">Lọc</button>
</form>

<div class="panel">
  <div class="panel-body compact">
    @if (!Model.Items.Any())
    {
      <div class="empty-state">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <h3>Không có POI</h3>
        <p>Thử thay đổi từ khóa hoặc bộ lọc</p>
      </div>
    }
    else
    {
      <table>
        <thead>
          <tr>
            <th style="width: 80px;">Ảnh</th>
            <th style="width: 60px;">ID</th>
            <th>Tên quán</th>
            <th>Loại</th>
            <th>Tọa độ</th>
            <th>Bán kính</th>
            <th>Priority</th>
            <th>Trạng thái</th>
            <th style="width: 140px; text-align: right;">Thao tác</th>
          </tr>
        </thead>
        <tbody>
        @foreach (var p in Model.Items)
        {
          <tr>
            <td>
              @if (!string.IsNullOrWhiteSpace(p.ImageUrl))
              {
                <img src="@p.ImageUrl" alt="" class="thumb" onerror="this.style.display='none'" />
              }
              else
              {
                <div class="thumb-placeholder">🍜</div>
              }
            </td>
            <td style="color: var(--text-2); font-family: monospace;">#@p.Id</td>
            <td>
              <div class="poi-name">@p.Name</div>
              <div class="poi-desc">@(p.DescriptionVi?.Length > 60 ? p.DescriptionVi.Substring(0, 60) + "…" : p.DescriptionVi)</div>
            </td>
            <td><span class="badge badge-@p.Category">@CategoryLabel(p.Category)</span></td>
            <td class="poi-coord">@p.Latitude.ToString("F5"), @p.Longitude.ToString("F5")</td>
            <td>@p.RadiusMeters.ToString("F0")m</td>
            <td>
              <span style="color: @(p.Priority >= 4 ? "var(--orange-bright)" : "var(--text-1)"); font-weight: @(p.Priority >= 4 ? 600 : 400);">
                @(new string('★', p.Priority))@(new string('☆', 5 - Math.Min(p.Priority,5)))
              </span>
            </td>
            <td>
              <span class="status-dot @(p.IsActive ? "status-active" : "status-inactive")"></span>
              @(p.IsActive ? "Hoạt động" : "Tạm dừng")
            </td>
            <td>
              <div class="row-actions">
                <a class="btn-icon" asp-controller="Pois" asp-action="Edit" asp-route-id="@p.Id" title="Chỉnh sửa">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                </a>
                @if (p.IsActive)
                {
                  <form asp-action="Delete" asp-route-id="@p.Id" method="post" style="display:inline;"
                        onsubmit="return confirm('Bạn có chắc muốn vô hiệu hóa &quot;@p.Name&quot;?');">
                    @Html.AntiForgeryToken()
                    <button class="btn-icon btn-danger-icon" type="submit" title="Xóa">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
                    </button>
                  </form>
                }
                else
                {
                  <form asp-action="Restore" asp-route-id="@p.Id" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button class="btn-icon" type="submit" title="Khôi phục" style="color: var(--green);">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/></svg>
                    </button>
                  </form>
                }
              </div>
            </td>
          </tr>
        }
        </tbody>
      </table>
    }
  </div>

  @if (Model.TotalPages > 1)
  {
    <div class="pagination">
      <div>Hiển thị <strong>@((Model.Page-1) * Model.PageSize + 1)-@Math.Min(Model.Page * Model.PageSize, Model.TotalCount)</strong> / <strong>@Model.TotalCount</strong> POI</div>
      <div class="pagination-controls">
        <a class="page-btn @(Model.Page == 1 ? "disabled" : "")"
           href="?page=@(Model.Page-1)&q=@Model.SearchQuery&cat=@Model.CategoryFilter&deleted=@Model.ShowDeleted.ToString().ToLower()">‹</a>
        @for (var i = 1; i <= Model.TotalPages; i++)
        {
          <a class="page-btn @(i == Model.Page ? "active" : "")"
             href="?page=@i&q=@Model.SearchQuery&cat=@Model.CategoryFilter&deleted=@Model.ShowDeleted.ToString().ToLower()">@i</a>
        }
        <a class="page-btn @(Model.Page >= Model.TotalPages ? "disabled" : "")"
           href="?page=@(Model.Page+1)&q=@Model.SearchQuery&cat=@Model.CategoryFilter&deleted=@Model.ShowDeleted.ToString().ToLower()">›</a>
      </div>
    </div>
  }
</div>

@functions {
    string CategoryLabel(string c) => c switch
    {
        "Oc" => "Ốc", "Nuong" => "Nướng", "Lau" => "Lẩu",
        "CaPhe" => "Cà phê", _ => "Khác"
    };
}
